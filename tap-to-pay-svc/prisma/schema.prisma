generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SaleStatus {
  AWAITING_TAP
  CHARGING
  PAID
  FAILED
}

model Buyer {
  id              String             @id @default(cuid())
  name            String
  // The wallet the buyer pays with by default. A plain id, not a foreign key, to avoid a Buyer <-> BuyerWallet cycle;
  // the service keeps it pointing at one of this buyer's wallets.
  defaultWalletId String?
  createdAt       DateTime           @default(now())
  wallets         BuyerWallet[]
  sales           Sale[]
  recurring       RecurringPayment[]
}

// One wallet address of a buyer (a "card" in the app). Caps and the grant live here, in this wallet's asset.
model BuyerWallet {
  id               String             @id @default(cuid())
  buyerId          String
  buyer            Buyer              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  walletAddress    String             @unique
  // The wallet address document's publicName, saved at registration and refreshed at service start.
  publicName       String?
  assetCode        String
  assetScale       Int
  perPaymentLimit  BigInt
  dailyLimit       BigInt
  grantAccessToken String?
  grantManageUrl   String?
  // The debitAmount approved per day in the grant, in this wallet's asset; null for grants without limits.
  grantDailyLimit  BigInt?
  createdAt        DateTime           @default(now())
  sales            Sale[]
  recurring        RecurringPayment[]
}

model Vendor {
  id              String             @id @default(cuid())
  name            String
  // MERCHANT sells with a terminal; BILLER is a service a buyer pays every month (EPM, Claro, …), kept out of the
  // vendor list the app picks from.
  kind            String             @default("MERCHANT")
  // The vendor as a payer: a Buyer holding the vendor's own wallet addresses, so its recurring payments are charged
  // with a grant like any payment. A plain id, like defaultWalletId; null until the vendor enrols its first payment.
  payerBuyerId    String?
  // The wallet a new sale receives into unless it names another. A plain id, like Buyer.defaultWalletId.
  defaultWalletId String?
  createdAt       DateTime           @default(now())
  wallets         VendorWallet[]
  sales           Sale[]
  recurring       RecurringPayment[]
}

// One receiving wallet address of a vendor. A sale is priced in the asset of the wallet it receives into.
model VendorWallet {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  walletAddress String   @unique
  // As BuyerWallet.publicName.
  publicName    String?
  assetCode     String
  assetScale    Int
  createdAt     DateTime @default(now())
  sales         Sale[]
}

model Sale {
  id                 String        @id @default(cuid())
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // The receiving wallet; null once that wallet is removed.
  vendorWalletId     String?
  vendorWallet       VendorWallet? @relation(fields: [vendorWalletId], references: [id], onDelete: SetNull)
  buyerId            String?
  buyer              Buyer?        @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerWalletId      String?
  buyerWallet        BuyerWallet?  @relation(fields: [buyerWalletId], references: [id], onDelete: SetNull)
  amount             BigInt
  assetCode          String
  assetScale         Int
  debitAmount        BigInt?
  debitAssetCode     String?
  debitAssetScale    Int?
  status             SaleStatus    @default(AWAITING_TAP)
  incomingPaymentUrl String?
  quoteId            String?
  outgoingPaymentUrl String?
  failureCode        String?
  failureMessage     String?
  // What the sale is for, shown to the buyer on the payment link and in WhatsApp.
  description        String?
  // The payment link's public code: the link and its QR never expose the sale id.
  payCode            String?       @unique
  payCodeExpiresAt   DateTime?
  // How the buyer reached the charge: NFC (tap) or LINK (WhatsApp link or QR). Set when a charge is attempted.
  chargedVia         String?
  createdAt          DateTime      @default(now())
  paidAt             DateTime?

  @@index([buyerId, status, createdAt])
  @@index([buyerWalletId, status, createdAt])
}

// A vendor's monthly payment to a service (a biller from the catalog, or any Interledger wallet), paid on time month
// after month to build a payment history. Each run is an ordinary sale to the biller's vendor, charged from the vendor's
// payer identity (buyerId) with its wallet's grant, like a tap.
model RecurringPayment {
  id                 String       @id @default(cuid())
  // The vendor that owes it.
  vendorId           String
  vendor             Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // The vendor's payer identity (Vendor.payerBuyerId).
  buyerId            String
  buyer              Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  // The wallet that pays; null once removed, then the buyer's default wallet pays.
  walletId           String?
  wallet             BuyerWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  // The catalog id (epm, claro, …); null for a payee the buyer typed.
  billerId           String?
  payeeName          String
  payeeWalletAddress String
  payeeAssetCode     String
  payeeAssetScale    Int
  // Contract, line or account number at the payee.
  reference          String?
  // In the payee's asset, smallest unit.
  amount             BigInt
  // 1 to 28, so every month has it; runs at 08:00 local (DAILY_LIMIT_TZ).
  dayOfMonth         Int
  active             Boolean      @default(true)
  nextRunAt          DateTime
  lastRunAt          DateTime?
  lastSaleId         String?
  lastStatus         String?
  lastMessage        String?
  createdAt          DateTime     @default(now())

  @@index([active, nextRunAt])
  @@index([vendorId])
}
