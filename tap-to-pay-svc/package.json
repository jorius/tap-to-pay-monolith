    "@prisma/client": "7.10.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
