DATABASE_URL=postgresql://postgres:change-me@localhost:55000/tap_to_pay
POSTGRES_PASSWORD=change-me
PORT=4000
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/<service-or-vendor>
OP_KEY_ID=<key id shown by the Test Wallet>
OP_PRIVATE_KEY_PATH=./private.key
SEED_BUYER_NAME=<buyer name>
SEED_BUYER_WALLET=https://ilp.interledger-test.dev/<buyer>
SEED_VENDOR_NAME=<vendor name>
SEED_VENDOR_WALLET=https://ilp.interledger-test.dev/<vendor>
SEED_PER_PAYMENT_LIMIT=2000
SEED_DAILY_LIMIT=5000
DAILY_LIMIT_TZ=America/Bogota
CHARGE_POLL_SECONDS=8
# Payment links (WhatsApp and QR). The base URL phones and browsers reach the service at, e.g. http://<laptop-LAN-IP>:4000
# or the deployed https URL; left empty, each link uses the host of the request that created it.
PUBLIC_BASE_URL=
PAYMENT_LINK_TTL_MINUTES=1440
# Where the link page's button opens the app: taptopayapp:// for a development or release build; for Expo Go, Metro's
# address with /-- (the IP npx expo start shows), e.g. exp://192.168.1.16:8081/--
APP_LINK_BASE=taptopayapp://
