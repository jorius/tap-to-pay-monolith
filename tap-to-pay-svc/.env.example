DATABASE_URL=postgresql://postgres:change-me@localhost:55000/tap_to_pay
POSTGRES_PASSWORD=change-me
PORT=4000
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/<service-or-vendor>
OP_KEY_ID=<key id shown by the Test Wallet>
OP_PRIVATE_KEY_PATH=./private.key
SEED_BUYER_NAME=<buyer name>
SEED_BUYER_WALLET=https://ilp.interledger-test.dev/<buyer>
SEED_VENDOR_NAME=<vendor name>
SEED_VENDOR_WALLET=https://ilp.interledger-test.dev/<vendor>
SEED_PER_PAYMENT_LIMIT=2000
SEED_DAILY_LIMIT=5000
DAILY_LIMIT_TZ=America/Bogota
CHARGE_POLL_SECONDS=8
# Payment links (WhatsApp and QR). The base URL buyers open, e.g. http://<laptop-LAN-IP>:4000 or an https host or tunnel;
# left empty, each link uses the host of the request that created it (proxy headers honoured).
PUBLIC_URL=
PAYMENT_LINK_TTL_MINUTES=1440
APP_SCHEME=taptopayapp

# Recurring payments. The Interledger wallet each catalog service receives into, as id=url pairs (ids: epm, claro, tigo,
# movistar, etb, vanti); a service left out uses BILLERS_DEFAULT_WALLET, and with neither it shows as unavailable.
# BILLER_WALLETS=epm=https://ilp.interledger-test.dev/epm,claro=https://ilp.interledger-test.dev/claro
# BILLERS_DEFAULT_WALLET=https://ilp.interledger-test.dev/servicios
RECURRING_CHECK_MINUTES=15
