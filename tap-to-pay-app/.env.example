# ipconfig getifaddr en0; after a change restart Metro with npx expo start --clear
EXPO_PUBLIC_API_URL=http://<laptop-LAN-IP>:4000
# A release APK needs https: forward port 4000 with Public visibility (VS Code Ports panel, ngrok, cloudflared) and put
# that URL here, or pass it as the third argument of scripts/build-apk.sh.
# EXPO_PUBLIC_API_URL=https://<id>-4000.<region>.devtunnels.ms
