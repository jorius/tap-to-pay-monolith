# Phones on the laptop's Wi-Fi with a debug APK: ipconfig getifaddr en0, then restart Metro with npx expo start --clear
EXPO_PUBLIC_API_URL=http://<laptop-LAN-IP>:4000
# Phones on mobile data or any other network (release APKs): forward port 4000 with Public visibility (VS Code Ports
# panel, ngrok, cloudflared), put that https URL here and run npm run build:vendor and npm run build:buyer.
# EXPO_PUBLIC_API_URL=https://<id>-4000.<region>.devtunnels.ms
# The phone each build installs on (adb devices lists the serials). Without one, the only phone connected is used.
# VENDOR_DEVICE=<serial>
# BUYER_DEVICE=<serial>
