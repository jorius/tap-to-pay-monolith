{
  "expo": {
    "name": "Paynela",
    "slug": "paynela-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/paynela-icon.png",
    "scheme": "paynela",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "co.inteligenciaartesanal.taptopay",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/paynela-adaptive-foreground.png",
        "monochromeImage": "./assets/images/paynela-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFBFB",
          "image": "./assets/images/paynela-logo.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
